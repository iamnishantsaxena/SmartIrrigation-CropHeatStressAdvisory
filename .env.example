# Conduit API (https://conduit.jhubafrica.com). Leave blank to use the bundled CSV.
CONDUIT_API_KEY=
CONDUIT_EMAIL=
# Offline fallback. Default: Data/conduit_archive.csv if present, else Data/weatherdata.csv
# WEATHER_CSV=Data/weatherdata.csv
# Crop coefficient: ~0.4 initial, 1.15-1.2 mid-season maize, 1.0 = reference grass
CROP_KC=1.0
# Irrigation system application rate (mm/hour) and efficiency (drip ~0.9, sprinkler ~0.75)
APPLICATION_RATE_MM_H=3.0
IRRIGATION_EFFICIENCY=0.9
# Room (mm) left in the soil for rain; keep below readily available water (~18 mm shallow roots)
RAIN_BUFFER_MM=10
